# macOS
.DS_Store

# Microsoft Office lock / temp files
~$*

# PPTX skill working artifacts
unpacked/
thumbnails*.jpg
.playwright-mcp/

# Secrets / env
.env
.env.*
*.pem
*.key
credentials.json
secrets.json

# Confidential WSQ assessments — never push
assessemnt/
/assessment/
/assessment\ /

# Distribution archives (rebuildable — never pushed to GitHub)
*.zip
# ...except the Lab 4 Copilot Studio skill packages. These ARE the deliverable —
# learners upload the .zip itself at Skills → Add skill → Upload a skill.
# Rebuild with: python3 scripts/build_lab4_skill_packages.py
!labs/**/skills/_packages/*.zip

# Source material the project was derived from — not ours to republish.
**/reference/
**/references/
# ...except the skill builder scripts, which are a reference implementation the
# courseware build actually runs.
!.claude/skills/**/reference/
!.claude/skills/**/reference/**

# Build scratch / working dirs
__pycache__/
*.pyc
.qa/
.tmp-pa-import/
tmp/
output/
outputs/

# Local-only history: superseded deck carrying third-party reference screenshots,
# and the top-level archive of legacy assessment-plan documents.
courseware/archive/*-with-reference-slides.pptx
/archive/

# Course-specific assessment builders — they embed the confidential question
# papers and model answers. The generic engine (build_assessment.py) stays.
.claude/skills/wsq-assessment/build_assessment_course.py
.claude/skills/wsq-assessment/build_wsq_assessment.py

# Dataverse API build helpers — never commit session tokens or request bodies
scripts/copilot_studio_api/token.txt
scripts/copilot_studio_api/_body.json
scripts/copilot_studio_api/ids.json
scripts/copilot_studio_api/urls.json
scripts/copilot_studio_api/__pycache__/

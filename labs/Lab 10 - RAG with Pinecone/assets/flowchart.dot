digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.7",
         fontname="Arial", dpi=180];
  node [shape=box, style="rounded,filled", fillcolor="#F5F8FC",
        color="#8FA6C0", penwidth=1.5, fontname="Arial", fontsize=13,
        margin="0.16,0.12"];
  edge [color="#365C82", penwidth=1.7, arrowsize=0.8, fontname="Arial",
        fontsize=10, fontcolor="#365C82"];

      subgraph cluster_i {
        label="Ingestion — once"; fontname="Arial"; fontsize=11; color="#8FA6C0";
        br [label="20 brochures", fillcolor="#FFF4E5"];
        emb [label="Embed\nllama-text-embed-v2\n1024 dimensions"];
        idx [label="Pinecone index"];
        br -> emb -> idx;
      }
      q [label="Visitor question", fillcolor="#EAF2FF"];
      trig [label="HTTP trigger"];
      http [label="HTTP action\nquery Pinecone\ntop_k = 3"];
      comp [label="Compose\npaste the 3 nearest"];
      ag [label="Agent\nanswer from these only", fillcolor="#F1EAFE"];
      resp [label="Grounded answer", fillcolor="#E8F7EE"];
      q -> trig -> http -> comp -> ag -> resp;
      idx -> http [label="search"];
}

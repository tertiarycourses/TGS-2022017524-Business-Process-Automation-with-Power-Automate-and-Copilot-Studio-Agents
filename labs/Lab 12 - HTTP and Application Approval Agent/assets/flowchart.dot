digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.7",
         fontname="Arial", dpi=180];
  node [shape=box, style="rounded,filled", fillcolor="#F5F8FC",
        color="#8FA6C0", penwidth=1.5, fontname="Arial", fontsize=13,
        margin="0.16,0.12"];
  edge [color="#365C82", penwidth=1.7, arrowsize=0.8, fontname="Arial",
        fontsize=10, fontcolor="#365C82"];

      web [label="Public web form\napplication details", fillcolor="#EAF2FF"];
      trig [label="When an HTTP request\nis received"];
      comp [label="Compose\nnormalise the input"];
      look [label="SharePoint lookup\nduplicate check"];
      ag [label="Agent\nsix ordered rules\nstructured output", fillcolor="#F1EAFE"];
      cond [label="Condition on decision\nAPPROVED · REJECTED\nDUPLICATE · REVIEW", fillcolor="#FFF4E5"];
      resp [label="Response\nback to the page", fillcolor="#E8F7EE"];
      web -> trig -> comp -> look -> ag -> cond -> resp;
}

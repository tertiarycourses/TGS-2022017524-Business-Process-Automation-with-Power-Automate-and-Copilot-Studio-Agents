digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.7",
         fontname="Arial", dpi=180];
  node [shape=box, style="rounded,filled", fillcolor="#F5F8FC",
        color="#8FA6C0", penwidth=1.5, fontname="Arial", fontsize=13,
        margin="0.16,0.12"];
  edge [color="#365C82", penwidth=1.7, arrowsize=0.8, fontname="Arial",
        fontsize=10, fontcolor="#365C82"];

      account [label="Microsoft 365\nwork or school account", fillcolor="#EAF2FF"];
      env [label="Training Class N (Sandbox)\nDataverse · Copilot Credits", fillcolor="#FFF4E5"];
      studio [label="Copilot Studio\nNew experience on\nAgents · Workflows", fillcolor="#F1EAFF"];
      apps [label="Outlook · Excel (OneDrive)\nTeams · SharePoint"];
      ready [label="Ready for Labs 1–17", fillcolor="#E8F7EE"];
      account -> env [label=" switch into"];
      env -> studio [label=" select bottom-left"];
      account -> apps [label=" verify"];
      studio -> ready; apps -> ready;
}

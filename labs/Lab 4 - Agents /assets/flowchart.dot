digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.7",
         fontname="Arial", dpi=180];
  node [shape=box, style="rounded,filled", fillcolor="#F5F8FC",
        color="#8FA6C0", penwidth=1.5, fontname="Arial", fontsize=13,
        margin="0.16,0.12"];
  edge [color="#365C82", penwidth=1.7, arrowsize=0.8, fontname="Arial",
        fontsize=10, fontcolor="#365C82"];

      user [label="Colleague asks\nin Teams", fillcolor="#EAF2FF"];
      agent [label="Agent\ninstructions · skills\nknowledge · tools", fillcolor="#F1EAFE"];
      child [label="Connected agents\nPolicy · Leave · Onboarding"];
      tool [label="Tool = agent flow\naudit row · threshold", fillcolor="#E8F7EE"];
      human [label="Human review\nin Teams", fillcolor="#FDECEA"];
      done [label="Action taken\nand logged", fillcolor="#FFF4E5"];
      user -> agent; agent -> child [label="routes"]; agent -> tool [label="calls"];
      tool -> human [label="over threshold"]; human -> done;
}

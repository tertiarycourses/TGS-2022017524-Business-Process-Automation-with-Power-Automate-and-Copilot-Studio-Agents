digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.7",
         fontname="Arial", dpi=180];
  node [shape=box, style="rounded,filled", fillcolor="#F5F8FC",
        color="#8FA6C0", penwidth=1.5, fontname="Arial", fontsize=13,
        margin="0.16,0.12"];
  edge [color="#365C82", penwidth=1.7, arrowsize=0.8, fontname="Arial",
        fontsize=10, fontcolor="#365C82"];

      client [label="Client enquiry\nfrom the website", fillcolor="#EAF2FF"];
      ag [label="Agent\nclassify · tone · flags\nDRAFT the reply", fillcolor="#F1EAFE"];
      gate [label="Human review\napprove or reject\nin Microsoft Teams", fillcolor="#FDECEA"];
      sent [label="Reply sent\nand logged", fillcolor="#E8F7EE"];
      named [label="Assigned to a named\nperson who must call", fillcolor="#FFF4E5"];
      client -> ag -> gate;
      gate -> sent [label="approved"];
      gate -> named [label="rejected"];
}

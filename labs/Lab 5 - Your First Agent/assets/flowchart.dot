digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.6",
         fontname="Arial", dpi=180];
  node [shape=box, style="rounded,filled", fillcolor="#F5F8FC",
        color="#8FA6C0", penwidth=1.5, fontname="Arial", fontsize=12,
        margin="0.16,0.12"];
  edge [color="#365C82", penwidth=1.7, arrowsize=0.8, fontname="Arial",
        fontsize=10, fontcolor="#365C82"];

      create [label="Agents → New agent\nname: Lab 5 - HR Agent", fillcolor="#EAF2FF"];
      instr [label="Instructions box\npaste agent/instructions.md", fillcolor="#FFE9EC"];
      model [label="Model\nleave the default"];
      knowledge [label="Knowledge +\nupload HR Policies.pdf\nremove Search all websites", fillcolor="#FFF4E5"];
      preview [label="Preview tab\n3 tests incl. one refusal", fillcolor="#F1EAFF"];
      publish [label="Publish\n(Lab 17 adds the channels)", fillcolor="#E8F7EE"];
      create -> instr -> model -> knowledge -> preview -> publish;
      preview -> instr [label=" fix and retest", style=dashed, constraint=false];
}
